<mxfile host="app.diagrams.net">
  <diagram id="fluxo-atual" name="Fluxo atual">
    <mxGraphModel grid="1" gridSize="10" page="1" pageWidth="1360" pageHeight="1200" arrows="1" connect="1">
      <root>
        <mxCell id="0"/><mxCell id="1" parent="0"/>
        <mxCell id="titulo" value="Central de etiquetas · fluxo atual do usuário" style="text;html=1;fontSize=24;fontStyle=1;align=left;" vertex="1" parent="1"><mxGeometry x="40" y="20" width="850" height="40" as="geometry"/></mxCell>
        <mxCell id="nota" value="O app abre em Pedidos. As outras abas podem ser acessadas sem login. O pedido escolhido em uma aba não passa para a outra." style="text;html=1;whiteSpace=wrap;align=left;fontSize=14;" vertex="1" parent="1"><mxGeometry x="40" y="65" width="1180" height="30" as="geometry"/></mxCell>
        <mxCell id="inicio" value="Abrir a Central" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#dae8fc;strokeColor=#6c8ebf;fontStyle=1;" vertex="1" parent="1"><mxGeometry x="540" y="110" width="180" height="44" as="geometry"/></mxCell>
        <mxCell id="pedidos" value="Pedidos · tela inicial" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#d5e8d4;strokeColor=#82b366;fontStyle=1;" vertex="1" parent="1"><mxGeometry x="125" y="200" width="200" height="44" as="geometry"/></mxCell>
        <mxCell id="precos" value="Etiquetas de preço" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#fff2cc;strokeColor=#d6b656;fontStyle=1;" vertex="1" parent="1"><mxGeometry x="530" y="200" width="200" height="44" as="geometry"/></mxCell>
        <mxCell id="historico" value="Lotes salvos" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#dae8fc;strokeColor=#6c8ebf;fontStyle=1;" vertex="1" parent="1"><mxGeometry x="975" y="200" width="160" height="44" as="geometry"/></mxCell>
        <mxCell id="config" value="Configurações" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#e1d5e7;strokeColor=#9673a6;fontStyle=1;" vertex="1" parent="1"><mxGeometry x="1170" y="200" width="140" height="44" as="geometry"/></mxCell>
        <mxCell id="login" value="Acesso de fornecedor&lt;br&gt;CNPJ e senha" style="rounded=1;whiteSpace=wrap;html=1;" vertex="1" parent="1"><mxGeometry x="40" y="300" width="175" height="55" as="geometry"/></mxCell>
        <mxCell id="zpl" value="Importar ZPL ou ZIP original&lt;br&gt;(sem login)" style="rounded=1;whiteSpace=wrap;html=1;" vertex="1" parent="1"><mxGeometry x="235" y="300" width="175" height="55" as="geometry"/></mxCell>
        <mxCell id="buscar" value="Buscar pedidos, ver produtos e selecionar itens" style="rounded=1;whiteSpace=wrap;html=1;" vertex="1" parent="1"><mxGeometry x="40" y="400" width="175" height="60" as="geometry"/></mxCell>
        <mxCell id="solicitar" value="Solicitar etiquetas de volume à Havan e aplicar o ajuste" style="rounded=1;whiteSpace=wrap;html=1;" vertex="1" parent="1"><mxGeometry x="40" y="510" width="175" height="60" as="geometry"/></mxCell>
        <mxCell id="ajustar" value="Aplicar o mesmo ajuste ao arquivo importado" style="rounded=1;whiteSpace=wrap;html=1;" vertex="1" parent="1"><mxGeometry x="235" y="510" width="175" height="60" as="geometry"/></mxCell>
