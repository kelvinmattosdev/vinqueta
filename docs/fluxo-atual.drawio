        <mxCell id="sessao" value="Sessão do portal disponível?" style="rhombus;whiteSpace=wrap;html=1;fillColor=#fff2cc;strokeColor=#d6b656;" vertex="1" parent="1"><mxGeometry x="755" y="385" width="175" height="85" as="geometry"/></mxCell>
        <mxCell id="acesso" value="Entrar pelo mesmo Acesso de fornecedor e voltar a Preços. Se necessário, verificar o site ou importar arquivo local." style="rounded=1;whiteSpace=wrap;html=1;" vertex="1" parent="1"><mxGeometry x="970" y="390" width="230" height="75" as="geometry"/></mxCell>
