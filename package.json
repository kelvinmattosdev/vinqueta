{
  "name": "vinqueta",
  "version": "1.0.0",
  "private": true,
  "description": "Central de etiquetas de preço e volume para fornecedores",
  "author": {
    "name": "Kelvin Mattos",
    "url": "https://github.com/kelvinmattosdev"
  },
  "homepage": "https://github.com/kelvinmattosdev",
  "desktopName": "vinqueta.desktop",
  "license": "MIT",
  "type": "module",
  "main": "electron/main.cjs",
  "scripts": {
    "start": "npm run desktop",
    "dev": "vite --host 127.0.0.1",
    "desktop": "npm run build && electron .",
    "build": "tsc --noEmit && vite build",
    "test": "node --test tests/*.test.mjs",
    "setup:protocol": "node scripts/import-protocol.mjs",
    "check": "npm test && npm run build",
    "test:desktop": "npm run build && node scripts/smoke-desktop.mjs",
    "test:ui": "node scripts/check-ui.mjs",
    "test:theme": "node scripts/check-theme.mjs",
    "build:icon": "node scripts/build-icon.mjs",
    "pack:linux": "npm run build && npm run build:icon && node scripts/package-desktop.mjs linux-dir",
    "dist:linux": "npm run build && npm run build:icon && node scripts/package-desktop.mjs linux",
    "dist:win": "npm run build && npm run build:icon && node scripts/package-desktop.mjs win",
    "dist:mac": "npm run build && npm run build:icon && node scripts/package-desktop.mjs mac",
    "install:local": "npm run pack:linux && node scripts/install-local.mjs"
  },
  "build": {
    "appId": "com.kelvinmattosdev.vinqueta",
    "productName": "Vinqueta",
    "directories": {
      "output": "release",
      "buildResources": "build"
    },
    "files": [
      "dist/**/*",
      "electron/**/*",
      "shared/**/*",
      "build/icon.png",
      "package.json",
      "LICENSE",
      "CHANGELOG.md",
      "!**/.local/**"
    ],
    "asar": true,
    "win": {
      "target": "nsis",
      "icon": "build/icon.png",
      "artifactName": "vinqueta-${version}-windows-${arch}.${ext}"
    },
    "mac": {
      "target": "dmg",
      "icon": "build/icon.png",
      "category": "public.app-category.productivity",
      "artifactName": "vinqueta-${version}-macos-${arch}.${ext}"
    },
    "linux": {
      "maintainer": "Kelvin Mattos",
      "syncDesktopName": true,
      "executableName": "vinqueta",
      "category": "Office",
      "icon": "build/icon.png",
      "artifactName": "vinqueta-${version}-${arch}.${ext}",
      "desktop": {
        "entry": {
          "Name": "Vinqueta",
          "Comment": "Etiquetas de preço e volume",
          "StartupWMClass": "vinqueta",
          "Keywords": "Vinqueta;Etiquetas;Havan;ZPL;"
        }
      }
    },
    "deb": {
      "depends": [
        "libgtk-3-0", "libnotify4", "libnss3", "libxss1", "libxtst6", "xdg-utils",
        "libatspi2.0-0", "libuuid1", "libsecret-1-0", "gjs", "gir1.2-secret-1", "cups-client"
      ],
      "fpm": [
        "README.md=/usr/share/doc/vinqueta/README.md",
        "SECURITY.md=/usr/share/doc/vinqueta/SECURITY.md",
        "docs/theme.md=/usr/share/doc/vinqueta/docs/theme.md"
      ]
    }
  },
  "dependencies": {
    "@fontsource/chivo": "^5.2.8",
    "@fontsource/chivo-mono": "^5.2.7",
    "@napi-rs/keyring": "2.1.2",
    "cheerio": "^1.2.0",
    "fast-xml-parser": "^5.12.1",
    "jszip": "^3.10.1",
    "lucide-react": "^0.468.0",
    "node-forge": "^1.3.1",
    "node-unrar-js": "^2.0.2",
    "react": "^19.0.0",
    "react-dom": "^19.0.0"
  },
  "devDependencies": {
    "@types/react": "^19.0.0",
    "@types/react-dom": "^19.0.0",
    "@vitejs/plugin-react": "^4.3.4",
    "electron": "^45.3.1",
    "electron-builder": "^26.18.0",
    "playwright-core": "^1.65.0",
    "typescript": "^5.7.3",
    "vite": "^6.1.0"
  }
}
